# Frontend Astro. Utilizar Node 22 LTS.
STRAPI_URL=http://localhost:1337
# Mismo secreto aleatorio que en cms/.env; no usar una contraseña de ejemplo.
PREVIEW_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# El destino está fijado en src/config/mail.mjs: flora.bula@inseso.org.
# SMTP_TO no se utiliza para evitar desvíos por una configuración antigua.
SMTP_FROM=

# CAMBIO INSESO FINAL: origen público, agenda y volumen persistente.
# Local: use la dirección exacta desde la que abre la página.
SITE_ORIGIN=http://localhost:4321
APPOINTMENTS_ENABLED=false
APPOINTMENTS_DB_PATH=./var/appointments.sqlite
# Activar únicamente después de configurar SMTP y validar las oficinas/trámites
# habilitados en src/data/appointments.json. No incluya este archivo .env en Git.
# Solo true detrás de un proxy local que sobrescriba X-Real-IP y con Node enlazado a 127.0.0.1.
TRUST_PROXY_IP=false

HOST=127.0.0.1
PORT=4321
