{
  "name": "inseso-astro",
  "type": "module",
  "version": "1.0.0-final",
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/astro/astro.js dev",
    "start": "node --env-file-if-exists=.env ./node_modules/astro/astro.js dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "start:production": "node --env-file=.env dist/server/entry.mjs",
    "citas:correos": "node --env-file=.env scripts/appointment-mail-worker.mjs",
    "test:agenda": "node scripts/test-appointments.mjs",
    "test:entrega": "node scripts/test-final.mjs",
    "smtp:verificar": "node --env-file=.env scripts/check-smtp.mjs",
    "test:contacto": "node scripts/test-contact.mjs",
    "test:formularios": "npm run build && node scripts/test-formularios-pdf.mjs && node scripts/test-institutional-form-ui.mjs && node scripts/test-form-api.mjs",
    "test:slide": "node scripts/test-carousel.mjs",
    "prebuild": "node scripts/check-translations.mjs",
    "test:traducciones": "npm run build && node scripts/test-translations.mjs",
    "test:fichas": "node scripts/test-source-forms.mjs",
    "test:normativas": "node scripts/test-normativas.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^9.5.1",
    "@astrojs/sitemap": "^3.6.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/vite": "^4.1.17",
    "astro": "^5.15.9",
    "nodemailer": "^7.0.10",
    "pdf-lib": "^1.17.1",
    "qs": "^6.14.0",
    "sharp": "^0.34.5",
    "strapi-llm-translator": "^0.10.0",
    "swiper": "^11.1.14",
    "tailwindcss": "^4.1.17"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4"
  }
}
