---
import formClientKeys from '../i18n/form-client-keys.json';
import {releaseLocales,createLocalizer} from '../i18n/release.mjs';
// CAMBIO WEB_INSESO: validación compartida, firma y acciones independientes.
import {webForms,FORM_PATTERNS} from '../data/web-forms.mjs';
import {getLangFromUrl,getLocalizedPath} from '../i18n/utils';
const lang=getLangFromUrl(Astro.url),key=Astro.url.searchParams.get('tipo')||'',config=Object.hasOwn(webForms,key)?webForms[key]:null;
const today=new Intl.DateTimeFormat('en-CA',{timeZone:'Africa/Malabo',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());

const l=createLocalizer(lang);
---
<main class="form-page container">
 <a class="back" href={getLocalizedPath('/formularios-web',lang)}>{l("← Todos los formularios")}</a>
 {config ? <><header><span>{l("INSESO · FORMULARIOS")}</span><h1>{l(config.title)}</h1><p>{l(config.note || 'Complete los campos obligatorios para imprimir la ficha. Puede descargar el original en blanco en cualquier momento.')}</p></header>
 <div class="form-notice"><strong>{l("Elija qué hacer con su formulario.")}</strong> {l("Al imprimir, el servidor coloca los datos en el modelo original. Descargar el formulario no requiere introducir datos.")}</div>
 <p class="required-note">{l("Los campos con * son obligatorios. Los apartados reservados al INSESO se completan en la oficina.")}</p><noscript>{l("Active JavaScript para completar la ficha digital o descargue el documento original.")}</noscript>
 <form autocomplete="off" data-institutional-form data-form-type={key} data-lang={lang} data-ui={JSON.stringify(Object.fromEntries(formClientKeys.map(key=>[key,releaseLocales[lang][key]])))}>
 {config.sections.map((section,si)=><fieldset><legend><span>{String(si+1).padStart(2,'0')}</span> {l(section.title)}</legend><div class:list={{fields:true,history:(key==='prestacion'&&si===3)||(key==='trabajador'&&si===5)}}>{section.fields.map(field=>field.type==='photo'?<div class="photo-space" role="img" aria-label={l('Foto')}><span>{l('Foto')}</span><small>{l('A completar por INSESO')}</small></div>:field.type==='choice'?<div class="choice-field" role="group" aria-labelledby={`${field.id}-label`}><span class="field-label" id={`${field.id}-label`}>{l(field.label)}{field.required?' *':''}<small>{l(field.multiple?'Puede seleccionar varias opciones.':'Seleccione una sola opción.')}</small></span><div class="choices">{field.options?.map((option,oi)=><label class="check"><input type={field.multiple?'checkbox':'radio'} name={field.id} value={option} required={field.required&&!field.multiple} aria-describedby={`${field.id}-error`} /><span>{l(option)}</span></label>)}</div><small class="field-error" id={`${field.id}-error`} data-field-error={field.id}></small></div>:<label class:list={{full:field.type==='textarea'}}><span>{l(field.label)}{field.historyRow?` · ${field.historyRow}`:''}{field.required?' *':''}</span>{field.type==='textarea'?<textarea name={field.id} rows="4" maxlength={field.maxLength} required={field.required} aria-describedby={`${field.id}-hint ${field.id}-error`}></textarea>:<input name={field.id} type={field.inputType||'text'} pattern={field.type==='date'?undefined:field.pattern} maxlength={field.maxLength} inputmode={field.inputMode} required={field.required} disabled={field.readOnly} placeholder={field.readOnly?l('A completar por INSESO'):undefined} max={field.type==='date'?today:undefined} aria-describedby={`${field.id}-hint ${field.id}-error`} title={l(field.hint)} />}{!field.readOnly&&field.hint&&<small class="field-hint" id={`${field.id}-hint`}>{l(field.hint)}</small>}<small class="field-error" id={`${field.id}-error`} data-field-error={field.id}></small></label>)}</div></fieldset>)}
 {key==='reembolso' && <p class="form-notice">{l("Se realizará una conciliación entre los precios del INSESO y las facturas aportadas, conforme a la nota de la ficha original. No adjunte informes médicos en esta página.")}</p>}
 <fieldset class="signature"><legend>{l("Firma del solicitante o de la persona responsable")}</legend><div class="signature-methods no-print"><label><input type="radio" name="signatureMethod" value="name" checked /> {l("Firmar con mi nombre")}</label><label><input type="radio" name="signatureMethod" value="paper" /> {l("Firmar a mano después de imprimir")}</label></div>
 <div data-name-signature><label class="signature-name">{l("Nombre completo del firmante *")}<input name="signatureName" pattern={FORM_PATTERNS.name} minlength="2" maxlength="120" required autocomplete="name" /></label><p class="field-hint no-print">{l("Escriba su nombre y confirme la declaración. Si lo desea, añada su firma con el ratón o con el dedo.")}</p><canvas width="640" height="180" data-signature-canvas aria-label={l("Zona opcional para dibujar la firma. También puede firmar escribiendo su nombre.")}></canvas><button type="button" class="secondary no-print" data-clear-signature>{l("Limpiar trazo")}</button><label class="ack no-print"><input type="checkbox" name="signatureConfirmed" required /> {l("Confirmo que soy la persona firmante y que los datos consignados son correctos. *")}</label><small class="field-hint">{l("Esta firma por nombre escrito no incorpora un certificado digital.")}</small></div>
 <div data-paper-signature hidden><p>{l("Imprima la ficha cumplimentada y firme a mano en el espacio indicado.")}</p><div class="paper-line"></div></div><small class="field-error" data-field-error="signatureName"></small><small class="field-error" data-field-error="signature"></small></fieldset>
 <div class="honey" aria-hidden="true"><input name="website" tabindex="-1" autocomplete="off" /></div><div class="form-errors no-print" data-error-summary role="alert" hidden></div><p data-form-status role="status" aria-live="polite" class="no-print"></p><div class="form-actions no-print"><button type="button" data-form-action="print">{l("Imprimir")}</button><a class="form-download" href={config.source} download>{l("Descargar formulario")}</a><button type="reset" class="secondary">{l("Limpiar formulario")}</button></div>
 </form></> : <><h1>{l("Formulario no encontrado")}</h1><p>{l("Seleccione una ficha disponible.")}</p></>}
</main>
<script>
 import {bindInstitutionalForms} from '../lib/institutional-form';bindInstitutionalForms();document.addEventListener('astro:page-load',bindInstitutionalForms);
</script>
<style>
.form-page{max-width:1000px;padding-top:3rem;padding-bottom:4rem;color:#203c2b}.back,.form-page a{color:#225924;text-decoration:underline}.form-page header{margin:1.5rem 0;background:linear-gradient(120deg,#174d2b,#367a40);border-radius:20px;color:white;padding:2rem}.form-page header span{font-size:.8rem;font-weight:700;letter-spacing:.1em;color:#d5e9d7}.form-page h1{font-size:clamp(1.8rem,4vw,2.7rem);color:white;margin:.7rem 0}.form-page p{line-height:1.65}.form-notice{padding:1rem 1.2rem;background:#edf6ef;border-left:4px solid #367a40;border-radius:8px;line-height:1.6}.required-note,.field-hint{font-size:.8rem;color:#526859}.form-page fieldset{border:1px solid #d5e6d9;border-radius:16px;padding:1.5rem;margin:1.5rem 0;background:white;box-shadow:0 8px 24px #174d2b0d;break-inside:avoid}.form-page legend{font-size:1.2rem;font-weight:700;color:#225924;width:auto;padding:0 .5rem}.form-page legend span{font-size:.75rem;color:#4f8058;background:#e5f1e7;padding:.4rem;border-radius:5px}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.fields.history{grid-template-columns:repeat(3,minmax(0,1fr))}.photo-space{width:140px;height:170px;border:1px dashed #7d9d85;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.8rem;text-align:center}.photo-space small{font-size:.75rem}.fields>label,.choice-field,.signature-name,.delivery>label{display:flex;flex-direction:column;gap:.4rem;font-weight:600}.fields label span,.field-label{line-height:1.4}.form-page input:not([type=checkbox]):not([type=radio]),.form-page textarea{width:100%;border:1px solid #aac6b0;border-radius:7px;padding:.65rem;min-height:44px;background:#fff}.form-page input:disabled{background:#f1f4f1}.form-page input:focus,.form-page textarea:focus{outline:3px solid #c3dcc8;border-color:#367a40}.choice-field,.full{grid-column:1/-1}.field-label small{display:block;font-size:.8rem;font-weight:400;color:#526859;margin-top:.3rem}.choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem}.choices .check{display:flex;align-items:flex-start;gap:.5rem;font-size:.92rem;font-weight:400}.check input,.ack input{margin-top:.35rem;flex-shrink:0}.field-error{display:block;min-height:.2rem;color:#9c241e;font-size:.82rem}.field-error:empty{display:none}.signature-methods{display:flex;flex-wrap:wrap;gap:1.2rem;margin-bottom:1.2rem}.signature-methods label,.ack{display:flex;gap:.6rem;align-items:flex-start;line-height:1.6}.signature canvas{display:block;width:100%;max-width:640px;height:auto;border:1px dashed #7d9d85;border-radius:8px;touch-action:none;background:white;margin:1rem 0}.signature .paper-line{height:65px;border-bottom:1px solid #667;width:280px}.signature .ack{margin-top:1rem}.delivery{background:#f5faf6!important}.delivery>p{font-size:.9rem}.form-actions{display:flex;gap:.8rem;flex-wrap:wrap}.form-page button,.form-page .form-download{padding:.8rem 1.2rem;border:1px solid #225924;border-radius:8px;background:#225924;color:white;font-weight:600;cursor:pointer}.form-page .form-download{background:white;color:#225924;text-decoration:none}.form-page button:disabled{opacity:.5;cursor:not-allowed}.form-page button.secondary{background:white;color:#225924}.form-errors{padding:1rem;background:#fff1ef;color:#9c241e;border-radius:8px;margin:1rem 0}.honey{position:absolute;left:-10000px}.print-only{display:none}:global(.print-field-value){display:none}.form-page [hidden]{display:none!important}@media(max-width:650px){.fields,.choices,.fields.history{grid-template-columns:1fr}.form-page fieldset{padding:1rem}}@media print{.form-page{display:none!important}}
</style>
