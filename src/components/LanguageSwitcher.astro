---
// CAMBIO INSESO FINAL: cuatro opciones visibles, accesibles incluso sin JavaScript.

// CAMBIO INSESO 2026-10-13: identidad verde y correcciones previas; detalles en docs/CAMBIOS_REVISION_2.md.
import benefits from '../data/benefits.json';
import { languages, type Locale, getLocalizedPath, removeLocalePrefix, routeTranslations } from '../i18n/utils';
import { getPrestacionBySlug, getPrestacionSlugsByDocumentId, getNoticiaBySlug, getNoticiaSlugsByDocumentId } from '../lib/strapi';

interface Props {
  currentLang: Locale;
  currentPath?: string;
  instance?: string;
}

const { currentLang, currentPath = '/' } = Astro.props;

// Remover prefijo de idioma si existe para obtener la ruta base
const basePath = removeLocalePrefix(currentPath);

// Detectar si estamos en una página de prestación dinámica
const prestacionMatch = basePath.match(/^\/prestacion\/(.+)$/);
const currentPrestacionSlug = prestacionMatch ? prestacionMatch[1] : null;

// Detectar si estamos en una página de noticia individual
const noticiaMatch = basePath.match(/^\/noticias\/(.+)$/);
const currentNoticiaSlug = noticiaMatch ? noticiaMatch[1] : null;

// Si estamos en una página de prestación, obtener los slugs en todos los idiomas
let prestacionSlugs: Record<string, string> = {};
if (currentPrestacionSlug && !benefits.some(b => b.slug === currentPrestacionSlug)) {
  const currentPrestacion = await getPrestacionBySlug(currentPrestacionSlug, currentLang);
  if (currentPrestacion?.documentId) {
    prestacionSlugs = await getPrestacionSlugsByDocumentId(currentPrestacion.documentId);
  }
}

// Si estamos en una página de noticia, obtener los slugs en todos los idiomas
let noticiaSlugs: Record<string, string> = {};
if (currentNoticiaSlug) {
  const currentNoticia = await getNoticiaBySlug(currentNoticiaSlug, currentLang);
  if (currentNoticia?.documentId) {
    noticiaSlugs = await getNoticiaSlugsByDocumentId(currentNoticia.documentId);
  }
}

// Generar URLs para cada idioma con rutas traducidas
const langLinks = Object.entries(languages).map(([code, name]) => {
  const targetLang = code as Locale;
  let translatedPath = basePath;

  // Si es una página de prestación, usar el slug del idioma correspondiente
  if (currentPrestacionSlug && benefits.some(b => b.slug === currentPrestacionSlug)) {
    translatedPath = `/prestacion/${currentPrestacionSlug}`;
  }
  else if (currentPrestacionSlug && prestacionSlugs[targetLang]) {
    translatedPath = `/prestacion/${prestacionSlugs[targetLang]}`;
  }
  // Si es una página de noticia, usar el slug del idioma correspondiente
  else if (currentNoticiaSlug && noticiaSlugs[targetLang]) {
    translatedPath = `/noticias/${noticiaSlugs[targetLang]}`;
  }
  // Para otras páginas, buscar en routeTranslations
  else if (currentPrestacionSlug || currentNoticiaSlug) {
    translatedPath = currentPrestacionSlug ? '/Prestaciones_Sociales' : '/noticias';
  }
  else {
    const currentRoutes = routeTranslations[currentLang];
    const targetRoutes = routeTranslations[targetLang];

    const routeKey = Object.keys(currentRoutes).find(
      key => currentRoutes[key] === basePath
    );

    if (routeKey && targetRoutes[routeKey]) {
      translatedPath = targetRoutes[routeKey];
    }
  }

  return {
    code: targetLang,
    name,
    url: getLocalizedPath(translatedPath, targetLang)+(basePath==='/formulario-web'&&Astro.url.searchParams.has('tipo')?'?tipo='+encodeURIComponent(Astro.url.searchParams.get('tipo')!):''),
    missing: Boolean(currentNoticiaSlug && !noticiaSlugs[targetLang] && targetLang !== currentLang),
    active: currentLang === code
  };
});

// Banderas emoji por idioma
const flags: Record<Locale, string> = {
  es: '🇪🇸',
  fr: '🇫🇷',
  en: '🇬🇧',
  pt: '🇵🇹'
};

---
<!-- CAMBIO DEFINITIVO: selector compacto a la derecha, con opciones completas en mayúsculas. -->
<nav class="language-switcher" aria-label="ESPAÑOL · FRANÇAIS · ENGLISH · PORTUGUÊS"><details><summary><i class="fas fa-globe" aria-hidden="true"></i><strong>{currentLang.toUpperCase()}</strong><span class="current-name">{languages[currentLang].toLocaleUpperCase()}</span><span aria-hidden="true">⌄</span></summary><ul>{langLinks.map(lang=><li><a href={lang.url} hreflang={lang.code} lang={lang.code} aria-label={lang.name} aria-current={lang.active?'page':undefined} class:list={{active:lang.active}}>{lang.name.toLocaleUpperCase()}</a></li>)}</ul></details></nav>
<script>
function bindLanguageMenu(){document.querySelectorAll<HTMLElement>('.language-switcher').forEach(root=>{if(root.dataset.bound)return;root.dataset.bound='true';const details=root.querySelector('details')!;document.addEventListener('click',e=>{if(!root.contains(e.target as Node))details.open=false;});root.addEventListener('keydown',e=>{if(e.key==='Escape'){details.open=false;root.querySelector('summary')?.focus();}});});}bindLanguageMenu();document.addEventListener('astro:page-load',bindLanguageMenu);
</script>
<style>.language-switcher{position:relative;flex-shrink:0;text-transform:uppercase}.language-switcher details{position:relative}.language-switcher summary{display:flex;align-items:center;gap:.5rem;min-height:44px;padding:.4rem .5rem;color:#225924;font-size:.85rem;font-weight:600;cursor:pointer;list-style:none;white-space:nowrap}.language-switcher summary::-webkit-details-marker{display:none}.language-switcher ul{position:absolute;right:0;top:100%;z-index:2000;width:190px;list-style:none;margin:.25rem 0 0;padding:.4rem;background:#fff;border:1px solid #c9dece;border-radius:10px;box-shadow:0 8px 24px #163f2726}.language-switcher li{margin:0;padding:0}.language-switcher a{display:flex;align-items:center;min-height:44px;padding:.65rem .8rem;color:#225924;font-size:.85rem;font-weight:600;text-decoration:none;text-transform:uppercase;border-radius:6px}.language-switcher a.active,.language-switcher a:hover{background:#225924;color:#fff}.language-switcher :focus-visible{outline:3px solid #367a40;outline-offset:3px}@media(max-width:600px){.current-name{display:none}.language-switcher summary{padding:.3rem;gap:.35rem}}</style>
