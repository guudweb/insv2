---
// CAMBIO INSESO 2026-10-13 R2: catálogo de ocho fichas, sin médico-farmacéuticas ni categorías ajenas al documento.
import {getBenefitCatalog} from '../data/benefit-catalog';
import {getLangFromUrl,getLocalizedPath,useTranslations,ui} from '../i18n/utils';
const lang=getLangFromUrl(Astro.url),benefitCatalog=getBenefitCatalog(lang),t=useTranslations(lang),words=ui[lang].benefitGroups;
---
<!-- CAMBIO INSESO R4: once fichas; muerte y supervivencia se presenta como una familia. -->
<div class="services-bar"><div class="container">
<nav class="benefit-groups" aria-label={words.navigation}><a href="#prestaciones-generales">{words.general}</a><a href="#muerte-supervivencia">{words.survival}</a></nav>
{['general','muerte-supervivencia'].map(group=><section id={group==='general'?'prestaciones-generales':'muerte-supervivencia'} class="benefit-group"><h2 class="group-title">{group==='general'?words.general:words.survivalTitle}</h2><div class="benefit-grid">{benefitCatalog.filter(b=>b.group===group).map(b=><article class="benefit-card"><a href={getLocalizedPath(`/prestacion/${b.slug}`,lang)} aria-label={b.titulo}><img src={b.imagen} alt={b.titulo} width="720" height="420" loading="lazy"/></a><div><h3>{b.titulo}</h3><a class="btn btn-primary" href={getLocalizedPath(`/prestacion/${b.slug}`,lang)}>{t('common.readMore')} <span aria-hidden="true">→</span></a></div></article>)}</div></section>)}
</div></div>
<style>.benefit-group{scroll-margin-top:2rem;margin-bottom:3rem}.group-title{font-size:1.8rem;margin:1.5rem 0;color:#225924}.benefit-groups{display:flex;gap:1rem;flex-wrap:wrap;margin-bottom:2rem}.benefit-groups a{background:#edf6ef;color:#225924;padding:.7rem 1rem;border:1px solid #cfdfd2;border-radius:20px}.benefit-groups a:hover{background:#dceede}.benefit-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem}.benefit-card{background:white;border:1px solid #deeadf;border-radius:18px;overflow:hidden;box-shadow:0 5px 20px #17522a0a;display:flex;flex-direction:column}.benefit-card img{width:100%;height:auto;aspect-ratio:12/7;object-fit:cover;background:#eff7f0}.benefit-card>div{padding:1.5rem;display:flex;flex-direction:column;flex:1}.benefit-card h3{font-size:1.35rem;line-height:1.4;margin-bottom:1.5rem}.benefit-card .btn{margin-top:auto;align-self:flex-start}@media(max-width:991px){.benefit-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:575px){.benefit-grid{grid-template-columns:1fr}}</style>
