---
import {createLocalizer} from '../i18n/release.mjs';
import {getLangFromUrl} from '../i18n/utils';
const l=createLocalizer(getLangFromUrl(Astro.url));
const documents=[{slug:'seguridad-social',title:'Seguridad Social',description:'Documento de normativa de la Seguridad Social.'},{slug:'entidades-autonomas-y-empresas-publicas',title:'Ley Reguladora de Entidades Autónomas y Empresas Públicas',description:'Documento de regulación de entidades autónomas y empresas públicas.'}];
---
<main class="regulations container"><header><span>INSESO</span><h1>{l('Normativas de la seguridad social')}</h1><p>{l('Descargue los documentos para consultar su contenido. Se facilitan los archivos originales en español.')}</p></header><div class="documents">{documents.map(document=><article><div class="document-icon" aria-hidden="true"><i class="fas fa-file-pdf"></i></div><div><span class="format">PDF</span><h2>{l(document.title)}</h2><p>{l(document.description)}</p><a href={`/descargas/normativas/${document.slug}`} download aria-label={`${l('Descargar PDF')} · ${l(document.title)}`}><i class="fas fa-download" aria-hidden="true"></i> {l('Descargar PDF')}</a></div></article>)}</div></main>
<style>.regulations{max-width:1050px;padding-top:3.5rem;padding-bottom:5rem;color:#203c2b}.regulations header{max-width:760px;margin-bottom:2.5rem}.regulations header>span{font-size:.8rem;letter-spacing:.12em;font-weight:700;color:#367a40}.regulations h1{font-size:clamp(2rem,4vw,2.8rem);line-height:1.2;margin:.8rem 0 1rem}.regulations p{color:#526859;line-height:1.7}.documents{display:grid;gap:1.2rem}.documents article{display:flex;align-items:flex-start;gap:1.5rem;padding:1.8rem;border:1px solid #c9dece;border-radius:18px;background:#f5faf6;box-shadow:0 8px 24px #174d2b0a}.document-icon{display:grid;place-items:center;flex-shrink:0;width:58px;height:70px;background:#e2efe5;border-radius:10px;color:#225924;font-size:1.9rem}.format{font-size:.75rem;font-weight:700;color:#527b59}.documents h2{font-size:1.3rem;line-height:1.5;margin:.4rem 0}.documents a{display:inline-flex;align-items:center;gap:.6rem;padding:.8rem 1.2rem;border-radius:8px;background:#225924;color:white;text-decoration:none;font-weight:600;transition:background .2s,transform .2s}.documents a:hover{background:#367a40;transform:translateY(-2px)}.documents a:focus-visible{outline:3px solid #80b38c;outline-offset:4px}@media(max-width:550px){.documents article{padding:1.2rem;gap:1rem}.document-icon{width:40px;height:52px;font-size:1.4rem}}@media(prefers-reduced-motion:reduce){.documents a{transition:none}}</style>
