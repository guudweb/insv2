---
// CAMBIO INSESO 2026-10-13 R2: diez ubicaciones; cada ficha reúne fotografía, dirección, email y horario.
import {getOffices} from '../data/offices';
import {getLangFromUrl} from '../i18n/utils';
const lang=getLangFromUrl(Astro.url);
const words={es:['Nuestras agencias','10 ubicaciones en 8 localidades','Lunes a viernes','Dirección','Correo electrónico','Horario de atención','Fotografía pendiente','Próxima sede · apertura pendiente','Horario previsto; confirme la apertura.'],fr:['Nos agences','10 implantations dans 8 localités','Du lundi au vendredi','Adresse','E-mail',"Horaires d’accueil",'Photographie à compléter','Prochain siège · ouverture à confirmer','Horaire prévu ; confirmez l’ouverture.'],en:['Our offices','10 locations in 8 towns','Monday to Friday','Address','Email','Opening hours','Photograph pending','Future headquarters · opening pending','Planned hours; please confirm opening.'],pt:['As nossas agências','10 instalações em 8 localidades','Segunda a sexta-feira','Endereço','E-mail','Horário de atendimento','Fotografia pendente','Próxima sede · abertura pendente','Horário previsto; confirme a abertura.']}[lang];
const offices=getOffices(lang);
---
<section class="office-page container"><header><span>INSESO</span><h1>{words[0]}</h1><p>{words[1]}</p></header>{offices.map(city=><section class="city"><h2>{city.ciudad}</h2><div class="office-grid">{city.localidades.map(office=><article class="office"><div class="office-photo">{office.imagen?<img src={office.imagen} alt={`${office.nombre} · ${city.ciudad}`} loading="lazy"/>:<div class="photo-pending"><i class="fas fa-building" aria-hidden="true"></i><span>{words[6]}</span><small>{office.nombre} · {city.ciudad}</small></div>}</div>{office.photoCredit&&<p class="office-photo-credit">{office.photoCaption}<br/><a href={office.photoSource} target="_blank" rel="noopener noreferrer">Foto: {office.photoCredit}</a></p>}<div class="office-info"><h3>{office.nombre}</h3>{office.future&&<p class="future">{words[7]}</p>}<dl><dt>{words[3]}</dt><dd>{office.direccion}</dd><dt>{words[4]}</dt><dd><a href={`mailto:${office.email}`}>{office.email}</a></dd></dl><div class="office-hours"><i class="far fa-clock" aria-hidden="true"></i><div><strong>{words[5]}</strong><span>{words[2]}</span><b>08:00 – 16:00</b>{office.future&&<small>{words[8]}</small>}</div></div></div></article>)}</div></section>)}</section>
<style>.office-photo-credit{font-size:.75rem;line-height:1.5;color:#607565;padding:.8rem 1.5rem 0;margin:0}.office-page{padding:3rem 15px 4rem}.office-page>header{padding:2rem;background:#eef6ee;border-radius:20px;margin-bottom:3rem}.office-page h1{font-size:2.6rem}.city{margin-bottom:3rem}.city>h2{font-size:1.6rem;color:#225924;margin-bottom:1.2rem}.office-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem}.office{border:1px solid #dae5db;border-radius:18px;overflow:hidden;background:white}.office-photo{height:230px;background:#eaf3eb}.office-photo img{width:100%;height:100%;object-fit:cover}.photo-pending{display:flex;align-items:center;justify-content:center;flex-direction:column;gap:.5rem;height:100%;color:#56705b;text-align:center;padding:1rem}.photo-pending i{font-size:3rem;color:#2d762f}.photo-pending small{max-width:300px}.office-info{padding:1.5rem}.office h3{font-size:1.2rem}.office dt{font-size:.85rem;color:#65766a;margin-top:1rem}.office dd{margin:.3rem 0}.office a{color:#225924}.office-hours{background:#edf6ef;padding:1rem;border-radius:12px;display:flex;gap:.8rem;margin-top:1.3rem;color:#17522a}.office-hours span,.office-hours strong,.office-hours b,.office-hours small{display:block}.office-hours b{font-size:1.2rem}.future{color:#866300;background:#fff9e8;padding:.6rem;border-radius:6px;font-size:.85rem}@media(max-width:767px){.office-grid{grid-template-columns:1fr}.office-page h1{font-size:2rem}}</style>
