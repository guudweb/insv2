---
// CAMBIO INSESO FINAL: no se conecta con proveedores de vídeo hasta una acción explícita.
import {getLangFromUrl,ui} from '../i18n/utils';
const lang=getLangFromUrl(Astro.url),w=ui[lang].legal;
const raw=String(Astro.props.src||'');let source='';
try{const url=new URL(raw);if(url.protocol==='https:'){
 if(['www.youtube.com','youtube.com','www.youtube-nocookie.com','youtu.be'].includes(url.hostname)){
  const id=url.hostname==='youtu.be'?url.pathname.split('/')[1]:url.pathname.startsWith('/watch')?url.searchParams.get('v'):url.pathname.split('/')[2];
  if(id&&/^[a-zA-Z0-9_-]{6,64}$/.test(id))source=`https://www.youtube-nocookie.com/embed/${id}`;
 }else if(['player.vimeo.com','vimeo.com','www.vimeo.com'].includes(url.hostname)){
  const id=url.pathname.split('/').filter(Boolean).pop();if(id&&/^\d+$/.test(id))source=`https://player.vimeo.com/video/${id}`;
 }else if(url.hostname==='www.google.com'&&url.pathname.startsWith('/maps/embed'))source=url.href;
}}catch{}

---
{source&&<div class="external-media" data-external-media data-src={source}><div class="external-notice"><h3>{w.externalTitle}</h3><p>{w.externalText}</p><button class="btn btn-primary" type="button">{w.externalButton}</button></div></div>}
<script>
function bindExternal(){document.querySelectorAll<HTMLElement>('[data-external-media]').forEach(root=>{if(root.dataset.bound)return;root.dataset.bound='true';root.querySelector('button')?.addEventListener('click',()=>{const frame=document.createElement('iframe');frame.src=root.dataset.src!;frame.title=root.querySelector('h3')?.textContent||'Video';frame.allowFullscreen=true;frame.referrerPolicy='no-referrer';frame.setAttribute('sandbox','allow-scripts allow-same-origin allow-presentation');frame.style.cssText='width:100%;height:450px;border:0;display:block';root.replaceChildren(frame);});});}bindExternal();document.addEventListener('astro:page-load',bindExternal);
</script>
<style>.external-media{background:#edf6ef;border:1px solid #c9dece;border-radius:14px;overflow:hidden;min-height:220px}.external-notice{padding:2rem;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:250px}.external-notice h3{font-size:1.2rem;color:#225924}.external-notice p{line-height:1.8;max-width:600px}</style>
