---
// CAMBIO INSESO FINAL: interfaz del formulario común traducida en JSON.
import {getLangFromUrl,ui} from '../i18n/utils';
const lang=getLangFromUrl(Astro.url),w=ui[lang].commonForm;
---
<section class="common-form container"><div class="form-intro"><span>{w.eyebrow}</span><h1>{w.title}</h1><p>{w.intro}</p><a class="btn btn-primary" href="/formularios/solicitud-comun-prestaciones.pdf" download="Solicitud_INSESO_prestaciones.pdf">{w.download}</a><a class="btn btn-outline-secondary" href="/formularios/solicitud-comun-prestaciones.pdf" target="_blank" rel="noopener noreferrer">{w.open}</a><p class="file-note">{w.source}</p></div><div class="form-help"><h2>{w.before}</h2><ol>{w.steps.map(step=><li>{step}</li>)}</ol><p>{w.downloadOnly}</p></div><div class="pdf-preview"><object data="/formularios/solicitud-comun-prestaciones.pdf" type="application/pdf" aria-label={w.preview}><a href="/formularios/solicitud-comun-prestaciones.pdf">{w.open}</a></object></div></section>
<style>.common-form{padding-top:3rem;padding-bottom:4rem;display:grid;grid-template-columns:1.5fr 1fr;gap:2rem}.form-intro h1{font-size:2.3rem;margin:.8rem 0 1.2rem}.form-intro span{color:#225924}.form-intro p,.form-help li{line-height:1.8}.form-intro .btn{margin:0 .6rem .8rem 0}.file-note{font-size:.8rem;color:#667}.form-help{padding:1.5rem;border-radius:18px;background:#edf6ed;align-self:start}.form-help h2{font-size:1.3rem}.pdf-preview{grid-column:1/-1;border:1px solid #dfe8df;border-radius:12px;overflow:hidden}.pdf-preview object{display:block;width:100%;height:800px}@media(max-width:767px){.common-form{grid-template-columns:1fr}.pdf-preview object{height:550px}}</style>
