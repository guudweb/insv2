---
// CAMBIO INSESO 2026-10-13 R3: preguntas desplegables accesibles; cada respuesta conserva la información facilitada.
import {benefitCatalog,canonicalBenefit} from '../data/benefit-catalog';
import {getBenefitQuestions} from '../data/benefit-faq';
import {getLangFromUrl,getLocalizedPath} from '../i18n/utils';
const lang=getLangFromUrl(Astro.url);
const benefit=benefitCatalog.find(b=>b.slug===canonicalBenefit(Astro.props.slug));
const questions=getBenefitQuestions(Astro.props.slug);
const labels={es:['Preguntas sobre la prestación','Pulse una pregunta para consultar su respuesta. Puede abrir varias a la vez.','Abrir todas','Cerrar todas','Formulario común','Descargar solicitud','Información recopilada el 8 de octubre de 2026.'],fr:['Questions sur la prestation','Cliquez sur une question pour afficher la réponse en espagnol.','Tout ouvrir','Tout fermer','Formulaire commun','Télécharger la demande','Texte de référence en espagnol, recueilli le 8 octobre 2026.'],en:['Questions about this benefit','Select a question to read the Spanish reference answer.','Expand all','Collapse all','Common application form','Download application','Spanish reference text collected on 8 October 2026.'],pt:['Perguntas sobre a prestação','Selecione uma pergunta para ler a resposta de referência em espanhol.','Abrir todas','Fechar todas','Formulário comum','Descarregar pedido','Texto de referência em espanhol, recolhido em 8 de outubro de 2026.']}[lang];
---
{benefit&&<div class="benefit-document"><aside class="benefit-index"><div class="form-panel"><h2>{labels[4]}</h2><p>Una misma solicitud para las ocho prestaciones.</p><a class="btn btn-primary" href={getLocalizedPath('/formulario-prestaciones',lang)}>Formularios</a><a class="download-link" href="/formularios/solicitud-comun-prestaciones.pdf" download>{labels[5]} (PDF)</a></div><p class="source-note" lang={lang}>{labels[6]}</p></aside><article lang="es" class="benefit-faq"><header class="faq-heading" lang={lang}><h2>{labels[0]}</h2><p>{labels[1]}</p><div class="faq-controls"><button type="button" data-faq-action="open">{labels[2]}</button><button type="button" data-faq-action="close">{labels[3]}</button></div></header>{questions.map((q,i)=><details class="faq-item" id={q.id}><summary><span class="faq-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><span class="faq-title">{q.question}{q.tag&&<small>{q.tag}</small>}</span><span class="faq-toggle" aria-hidden="true">+</span></summary><div class="faq-answer">{q.answers.length===1?<p>{q.answers[0]}</p>:<ul>{q.answers.map(line=><li>{line}</li>)}</ul>}{q.table&&<div class="table-scroll"><table><caption>Cuantía según el grado de invalidez</caption><thead><tr><th scope="col">Grado de invalidez</th><th scope="col">Prestación</th></tr></thead><tbody>{q.table.map(row=><tr><th scope="row">{row.grade}</th><td>{row.amount}</td></tr>)}</tbody></table></div>}</div></details>)}</article></div>}
<script>
 import {bindBenefitAccordions} from '../lib/benefit-accordion';
 bindBenefitAccordions();document.addEventListener('astro:page-load',()=>bindBenefitAccordions());
</script>
<style>.benefit-document{display:grid;grid-template-columns:250px minmax(0,1fr);gap:2.5rem;margin:2.5rem 0 4rem}.benefit-index{align-self:start;position:sticky;top:2rem;border:1px solid #dce7dd;border-radius:18px;padding:1.3rem;background:#f6faf6}.form-panel h2{font-size:1.15rem}.form-panel p{font-size:.9rem;line-height:1.7}.download-link{display:block;margin-top:1rem;text-decoration:underline}.source-note{font-size:.8rem;line-height:1.6;color:#617365;margin-top:1.5rem}.benefit-faq{min-width:0}.faq-heading h2{font-size:1.5rem;color:#225924}.faq-heading p{line-height:1.7;color:#54685a}.faq-controls{display:flex;gap:.8rem;flex-wrap:wrap;margin:1.1rem 0 1.6rem}.faq-controls button{background:white;border:1px solid #b6cdbb;color:#225924;border-radius:8px;padding:.5rem .9rem;cursor:pointer}.faq-controls button:hover{background:#e8f3ea}.faq-item{border:1px solid #d6e5d9;border-radius:14px;margin-bottom:.9rem;overflow:hidden;background:white;scroll-margin-top:2rem}.faq-item summary{display:flex;align-items:center;gap:1rem;padding:1.2rem;list-style:none;cursor:pointer;color:#17522a;font-weight:600;line-height:1.6}.faq-item summary::-webkit-details-marker{display:none}.faq-item summary:hover{background:#f0f7f1}.faq-item summary:focus-visible{outline:3px solid #258444;outline-offset:-3px}.faq-number{font-size:.8rem;background:#e4f0e6;border-radius:50%;width:32px;height:32px;display:flex;align-items:center;justify-content:center;flex-shrink:0}.faq-title{flex:1;min-width:0}.faq-title small{display:block;color:#5c7162;font-size:.75rem;font-weight:400;margin-top:.35rem}.faq-toggle{font-size:1.5rem;transition:transform .15s}.faq-item[open]{border-color:#85b191;box-shadow:0 3px 14px #17522a08}.faq-item[open] summary{background:#eaf4ec}.faq-item[open] .faq-toggle{transform:rotate(45deg)}.faq-answer{padding:1.4rem 1.5rem;color:#33463a;line-height:1.8}.faq-answer ul{padding-left:1.3rem}.faq-answer li{margin-bottom:.65rem}.faq-answer p:last-child,.faq-answer ul:last-child{margin-bottom:0}.table-scroll{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:.93rem}caption{caption-side:top;font-weight:600;color:#225924;padding:.7rem 0}th,td{padding:.8rem;border:1px solid #d8e5db;text-align:left;vertical-align:top}thead{background:#eaf4ec}tbody th{font-weight:500;width:53%}@media(max-width:900px){.benefit-document{grid-template-columns:1fr;gap:1.5rem}.benefit-index{position:static}.faq-item summary{padding:1rem;gap:.7rem}.faq-answer{padding:1rem}.faq-controls button{min-height:44px}}
@media print{.faq-item::details-content{content-visibility:visible!important}.faq-item{overflow:visible}.faq-controls,.benefit-index{display:none}.benefit-document{display:block}}
</style>
