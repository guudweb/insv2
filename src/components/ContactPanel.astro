---
import {FORM_PATTERNS} from '../data/web-forms.mjs';
import InsuredContactHighlight from './InsuredContactHighlight.astro';
// CAMBIO INSESO FINAL: formulario traducido, sin bloque Contactos, con información de datos visible.
import {getLangFromUrl,ui,getLocalizedPath} from '../i18n/utils';
const lang=getLangFromUrl(Astro.url),w=ui[lang].contactForm,legal=ui[lang].legal;
---
<div class="contact-panel container" data-contact-panel data-lang={lang} data-words={JSON.stringify(w)}><header><h1>{w.title}</h1><p><a href="mailto:info@inseso.org">info@inseso.org</a> · <a href="tel:1066">1066</a></p></header><InsuredContactHighlight /><div class="contact-grid"><section><h2>{w.heading}</h2><form id="contactForm">
<label for="contact-name">{w.name} *</label><input id="contact-name" name="name" pattern={FORM_PATTERNS.name} autocomplete="name" required minlength="2" maxlength="120"/>
<label for="contact-email">{w.email} *</label><input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254"/>
<label for="contact-phone">{w.phone}</label><input id="contact-phone" name="phone" type="tel" pattern={FORM_PATTERNS.phone} autocomplete="tel" maxlength="50"/>
<label for="contact-category">{w.category} *</label><select id="contact-category" name="category" required><option value="">{w.choose}</option>{['afiliacion','carne','prestaciones','informacion'].map((id,i)=><option value={id}>{w.categories[i]}</option>)}</select>
<label for="contact-message">{w.message} *</label><textarea id="contact-message" name="message" required minlength="2" maxlength="3000" rows="6"></textarea>
<p class="data-note">{w.privacy} <a href={getLocalizedPath('/privacidad',lang)}>{legal.more}</a></p><label class="ack"><input type="checkbox" name="privacy" required/>{w.ack} *</label>
<div class="honey" aria-hidden="true"><input name="website" tabindex="-1" autocomplete="off" aria-label="Website"/></div>
<p id="contact-result" role="status" aria-live="polite"></p><button type="submit" class="btn btn-primary" disabled>{w.submit}</button></form>
<p><a href="https://www.google.com/maps/search/?api=1&query=INSESO+Avenida+de+la+Independencia+Malabo" target="_blank" rel="noopener noreferrer">{w.map} ↗</a></p></section><aside><img src="/images/contacto/contacto-verde.png" alt={w.title} width="1125" height="1398" loading="lazy"/><a class="attention-link" href={getLocalizedPath('/cita-previa',lang)}>{ui[lang].attention.title} →</a></aside></div></div>
<script>
function bindContact(){const root=document.querySelector<HTMLElement>('[data-contact-panel]');if(!root||root.dataset.bound)return;root.dataset.bound='true';const w=JSON.parse(root.dataset.words||'{}'),form=root.querySelector<HTMLFormElement>('form')!,status=root.querySelector<HTMLElement>('#contact-result')!,button=form.querySelector<HTMLButtonElement>('button')!;const consent=form.querySelector<HTMLInputElement>('[name=privacy]')!;let busy=false;const syncConsent=()=>{button.disabled=busy||!consent.checked;};consent.addEventListener('change',syncConsent);syncConsent();form.addEventListener('submit',async e=>{e.preventDefault();if(busy||!consent.checked||!form.reportValidity())return;busy=true;button.disabled=true;status.textContent='…';const data=Object.fromEntries(new FormData(form));try{const result=await fetch('/api/send-email',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...data,privacy:consent.checked,lang:root.dataset.lang||'es'})});if(!result.ok)throw new Error();const response=await result.json();status.textContent=w.success+' · '+response.reference+(response.confirmation?'':' · '+w.receiptFailed);form.reset();}catch{status.textContent=w.error;}finally{busy=false;syncConsent();}});}bindContact();document.addEventListener('astro:page-load',bindContact);
</script>
<style>.contact-panel{padding-top:3rem;padding-bottom:4rem}.contact-panel h1{font-size:clamp(2rem,4vw,3rem);color:#163f27}.contact-grid{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:3rem;margin-top:2rem}.contact-panel h2{font-size:1.5rem;color:#225924}.contact-panel label{display:block;margin:1rem 0 .4rem}.contact-panel input:not([type=checkbox]),.contact-panel textarea,.contact-panel select{display:block;width:100%;border:1px solid #b4cfbb;border-radius:8px;padding:.7rem;min-height:44px;background:white;color:#254d32}.contact-panel .ack{display:flex;gap:.7rem;align-items:flex-start;font-size:.9rem;line-height:1.6}.ack input{margin-top:.4rem;flex-shrink:0}.data-note{font-size:.88rem;line-height:1.8;margin-top:1.2rem;padding:1rem;background:#edf6ef;border-radius:10px}.contact-panel a{color:#225924;text-decoration:underline}.contact-panel aside{align-self:start}.contact-panel aside img{width:100%;height:auto;border-radius:18px}.attention-link{display:block;padding:1.2rem;margin-top:1rem;border-radius:12px;background:#e2efe5;font-weight:600}.honey{position:absolute;left:-10000px}.contact-panel :focus-visible{outline:3px solid #367a40;outline-offset:3px}@media(max-width:767px){.contact-grid{grid-template-columns:1fr}.contact-panel aside img{max-height:450px;object-fit:contain}}
</style>
