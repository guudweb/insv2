---
// CAMBIO INSESO FINAL: iconos blancos con idénticas dimensiones y alineación.
import TikTokIcon from './TikTokIcon.astro';
const items=[['Facebook','https://www.facebook.com/share/19mnxTyaUk/','fab fa-facebook-f'],['X','https://x.com/inseso_ge','x'],['Instagram','https://www.instagram.com/inseso_ge/','fab fa-instagram'],['TikTok','https://www.tiktok.com/@inseso_ge?_r=1&_t=ZS-9AXhGFjd7yv','tiktok']];
---
<ul class="official-social">{items.map(([label,url,icon])=><li><a class="official-social-link" href={url} target="_blank" rel="noopener noreferrer" aria-label={`${label} de INSESO`}>{icon==='tiktok'?<TikTokIcon/>:icon==='x'?<span class="x-icon" aria-hidden="true">𝕏</span>:<i class={icon} aria-hidden="true"></i>}</a></li>)}</ul>
<style>.official-social{display:flex;align-items:center;gap:10px;list-style:none;margin:0;padding:0;flex-wrap:wrap}.official-social li{display:flex;margin:0;padding:0}.official-social .official-social-link{display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;flex-shrink:0;width:36px;height:36px;line-height:1;color:#fff!important;background:transparent;border:1px solid #ffffff60;border-radius:50%;padding:0;text-decoration:none;transition:background .2s,transform .2s}.official-social-link i,.x-icon{font-size:17px;line-height:1}.official-social-link :global(svg){display:block;width:18px;height:18px;fill:#fff!important}.official-social-link:hover{background:#ffffff22;transform:translateY(-2px)}.official-social-link:focus-visible{outline:3px solid #c4e6cb;outline-offset:3px}@media(prefers-reduced-motion:reduce){.official-social-link{transition:none}.official-social-link:hover{transform:none}}</style>
