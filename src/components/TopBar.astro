---
// CAMBIO INSESO 2026-10-13: identidad verde y correcciones previas; detalles en docs/CAMBIOS_REVISION_2.md.
// CAMBIO INSESO R4: encabezado sin teléfono ni apartado postal.
// TopBar component - Barra superior con redes sociales y contacto
import {createLocalizer} from '../i18n/release.mjs';
import {getLangFromUrl} from '../i18n/utils';
const l=createLocalizer(getLangFromUrl(Astro.url));
import SocialLinks from './SocialLinks.astro';
import { contactInfo } from '../config/contact';
---

<div class="top-bar">
	<div class="container">
		<div class="row">
			<div class="col-lg-6">
				<div class="social-media"><SocialLinks /></div>
			</div>
			<div class="col-lg-6">
				<div class="contact-details">
					<ul>
						<li><i class="fas fa-map-marker-alt"></i> {contactInfo.national.city} – {l(contactInfo.national.name)}</li>
					</ul>
				</div>
			</div>
		</div>
	</div>
</div>

<style>/* CAMBIO INSESO R4: redes alineadas con TikTok blanco. */.social-media ul{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap}.social-media li{display:flex;align-items:center;margin:0}.social-media a{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;color:white}</style>
