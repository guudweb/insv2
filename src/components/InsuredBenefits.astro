---
// CAMBIO WEB_INSESO 28/10: presentación de los beneficios con un slide reutilizado.
import InstitutionalSlide from './InstitutionalSlide.astro';
import {createLocalizer} from '../i18n/release.mjs';
import {getLangFromUrl,getLocalizedPath,ui} from '../i18n/utils';
const lang=getLangFromUrl(Astro.url);
const registration=Astro.props.registration===true;
const l=createLocalizer(lang),baseWords=ui[lang].release.benefits;
const words=registration?{...baseWords,title:l('Registro de beneficiarios'),intro:l('Registre a los familiares a cargo del trabajador asegurado y consulte la documentación correspondiente a cada situación familiar.'),heading:l('Prepare el registro de su familia'),cards:[['01',l('Identifique a los beneficiarios'),l('Consulte los familiares a cargo que pueden acceder a las prestaciones familiares.')],['02',l('Prepare los documentos'),l('Revise los documentos que corresponden a cada familiar y su situación.')],['03',l('Presente la solicitud'),l('Complete la documentación y preséntela en una delegación del INSESO.')]],cta:l('¿Qué documentos debo presentar para solicitar la prestación familiar?')}:baseWords;

---
<InstitutionalSlide frame={1} alt="Seguridad social para todos, hoy y mañana · INSESO" />
<main class="container insured-benefits"><header><span>{words.eyebrow}</span><h1>{words.title}</h1><p>{words.intro}</p></header><section aria-labelledby="family-benefits-title"><h2 id="family-benefits-title">{words.heading}</h2><div class="benefit-overview">{words.cards.map(([number,title,text])=><article><span aria-hidden="true">{number}</span><h3>{title}</h3><p>{text}</p></article>)}</div><a class="family-link" href={getLocalizedPath('/prestacion/prestaciones-familiares',lang)+(registration?'#pregunta-4':'')}>{words.cta} <span aria-hidden="true">→</span></a></section></main>
<style>.insured-benefits{padding-top:3rem;padding-bottom:4rem}.insured-benefits header{max-width:820px;margin-bottom:2.5rem}.insured-benefits header>span{color:#367a40;font-size:.8rem;font-weight:700;letter-spacing:.13em}.insured-benefits h1{font-size:clamp(2rem,4vw,3rem);color:#163f27;margin:.8rem 0 1rem;line-height:1.15}.insured-benefits p{line-height:1.8;color:#53675b}.insured-benefits h2{font-size:1.6rem;color:#225924;margin-bottom:1.5rem}.benefit-overview{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem}.benefit-overview article{border:1px solid #d5e6d9;border-radius:18px;padding:1.6rem;background:#f5faf6;transition:transform .2s,box-shadow .2s}.benefit-overview article:hover{transform:translateY(-5px);box-shadow:0 12px 25px #174d2b15}.benefit-overview article>span{display:inline-block;border-radius:8px;padding:.4rem .7rem;background:#e2eee4;color:#367a40;font-weight:700}.benefit-overview h3{font-size:1.25rem;color:#225924;margin:1rem 0 .6rem}.benefit-overview p{margin:0}.family-link{display:inline-flex;gap:1.2rem;align-items:center;padding:.9rem 1.3rem;background:#225924;border-radius:9px;color:white!important;font-weight:600;margin-top:1.8rem}.family-link:focus-visible{outline:3px solid #367a40;outline-offset:4px}@media(max-width:760px){.benefit-overview{grid-template-columns:1fr}}@media(prefers-reduced-motion:reduce){.benefit-overview article{transition:none}.benefit-overview article:hover{transform:none}}</style>
