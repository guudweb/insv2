---
// CAMBIO DEFINITIVO: contactos destacados con el banner existente del 1066, sin editar la imagen.
import {getLangFromUrl,ui} from '../i18n/utils';
const lang=getLangFromUrl(Astro.url),title=ui[lang].contactForm.title;
---
<aside class="insured-contact-highlight" aria-label={title}><div class="contact-actions"><h2>{title}</h2><a class="insured-phone" href="tel:1066"><i class="fas fa-phone" aria-hidden="true"></i>1066</a><a class="insured-email" href="mailto:info@inseso.org"><i class="fas fa-envelope" aria-hidden="true"></i>info@inseso.org</a></div><img src="/images/adaptadas/presentation-3.webp" alt={`${title} · 1066`} width="2048" height="683" loading="lazy"/></aside>
<style>.insured-contact-highlight{display:grid;grid-template-columns:minmax(230px,.7fr) minmax(0,2fr);align-items:center;gap:0;overflow:hidden;border-radius:18px;border:1px solid #c9dece;background:#17522a;margin:1.5rem 0 2rem;box-shadow:0 6px 22px #163f2712}.contact-actions{padding:1.5rem;color:#fff}.contact-actions h2{font-size:1.15rem;color:#fff!important;line-height:1.5;margin:0 0 .8rem}.contact-actions a{display:flex;align-items:center;gap:.6rem;color:#fff!important;text-decoration:none!important}.insured-phone{font-size:2.7rem;line-height:1.3;font-weight:800;margin-bottom:.5rem}.insured-phone i{font-size:1.5rem}.insured-email{font-size:1rem;font-weight:600;overflow-wrap:anywhere}.insured-contact-highlight img{display:block;width:100%;height:auto}.contact-actions a:hover{text-decoration:underline!important}.contact-actions a:focus-visible{outline:3px solid #c4e6cb;outline-offset:4px}@media(max-width:767px){.insured-contact-highlight{grid-template-columns:1fr}.contact-actions{display:flex;flex-wrap:wrap;align-items:center;column-gap:1.3rem;padding:1rem}.contact-actions h2{flex:0 0 100%}.insured-phone{font-size:2.2rem;margin-bottom:0}.insured-email{font-size:.95rem}}</style>
