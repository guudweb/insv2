---
import {createLocalizer} from '../i18n/release.mjs';
import InstitutionalSlide from './InstitutionalSlide.astro';
import {getLangFromUrl,getLocalizedPath} from '../i18n/utils';
const lang=getLangFromUrl(Astro.url); const forms=[['Registro de empresas','Datos generales, identificación, dirección y responsable.','empresa','fa-building'],['Ficha de afiliación','Datos personales, bancarios y laborales.','trabajador','fa-user'],['Solicitud de prestaciones sociales','Solicitante, prestación y datos del causante.','prestacion','fa-hands-helping'],['Reembolso médico-farmacéutico','Datos y documentación para solicitar un reembolso.','reembolso','fa-file-medical']];

const l=createLocalizer(lang);
---
<InstitutionalSlide frame={2} alt="Su bienestar, nuestro compromiso · INSESO" /><main class="container form-directory"><header><span>{l("INSESO · TRÁMITES")}</span><h1>{l("Formularios")}</h1><p>{l("Complete los campos obligatorios para imprimir la ficha. Puede descargar el original en blanco en cualquier momento.")}</p></header><div class="notice">{l("Al imprimir, el servidor coloca los datos en el modelo original. Descargar el formulario no requiere introducir datos.")}</div><div class="form-grid">{forms.map(([title,description,id,icon])=><article><i class={`fas ${icon}`} aria-hidden="true"></i><h2>{l(title)}</h2><p>{l(description)}</p><a href={`${getLocalizedPath('/formulario-web',lang)}?tipo=${id}`}>{l("Completar ficha")} <span aria-hidden="true">→</span></a></article>)}</div></main>
<style>.form-directory{padding-top:3rem;padding-bottom:4rem}.form-directory header{background:linear-gradient(120deg,#174d2b,#367a40);color:white;border-radius:20px;padding:2.5rem}.form-directory header span{letter-spacing:.12em;font-weight:700;font-size:.8rem;color:#d9ecd9}.form-directory h1{font-size:clamp(2rem,4vw,3rem);color:white;margin:.8rem 0}.form-directory header p{max-width:700px;line-height:1.7}.notice{background:#edf6ef;border-left:4px solid #367a40;padding:1rem;margin:1.5rem 0;border-radius:8px}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem}.form-grid article{padding:1.6rem;border:1px solid #d5e6d9;border-radius:16px;background:white;box-shadow:0 8px 25px #174d2b0d;transition:transform .2s,box-shadow .2s}.form-grid article:hover{transform:translateY(-4px);box-shadow:0 14px 30px #174d2b20}.form-grid i{color:#2e7540;background:#edf6ef;border-radius:10px;padding:.8rem;font-size:1.3rem}.form-grid h2{font-size:1.3rem;margin:1rem 0;color:#225924}.form-grid p{line-height:1.6}.form-grid a{font-weight:700;color:#225924;text-decoration:underline}.form-grid a span{margin-left:.5rem}@media(max-width:700px){.form-grid{grid-template-columns:1fr}}@media(prefers-reduced-motion:reduce){.form-grid article{transition:none}.form-grid article:hover{transform:none}}</style>
