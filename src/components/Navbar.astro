---
// CAMBIO INSESO 2026-10-13 R2: retirada información institucional y accesos de pago; empleadores sin descargas.
// Navbar component - Barra de navegación principal con soporte multiidioma
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath, ui, removeLocalePrefix } from '../i18n/utils';

const { currentPath: rawPath = '/' } = Astro.props;
const currentPath=removeLocalePrefix(rawPath)||'/';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const labels=ui[lang].release.nav;
const menus=[
 {label:t('nav.about'),links:[['/sobre_nosotros',t('nav.aboutPresentation')],['/organigrama',labels.gov],['/nuestras_agencias',t('nav.aboutAgencies')]]},
 {label:t('nav.insured'),links:[['/beneficios-asegurados',labels.benefits],['/Prestaciones_Sociales',t('nav.aboutServices')],['/solicitud_de_carne',labels.card]]},
 {label:labels.affiliation,links:[['/afiliacion-informacion',labels.general],['/afiliacion-empresas',labels.companies],['/afiliacion-trabajadores',labels.workers],['/afiliacion-beneficiarios',labels.dependents],['/afiliacion-autonomos',labels.self]]},
 {label:t('nav.contact'),links:[['/cita-previa',labels.booking],['/atencion-asegurado',labels.attention]]}
];

---

<nav class="navbar navbar-expand-lg navbar-dark bg-light top-nav">

	<div class="container">
		<a class="navbar-brand" href={getLocalizedPath('/', lang)}>
			<img src="/images/logo-nuevo.png" alt="INSESO" />
		</a>
		<button class="navbar-toggler navbar-toggler-right" type="button" data-nav-toggle aria-controls="navbarResponsive" aria-expanded="false" aria-label="Toggle navigation">
			<span class="fas fa-bars"></span>
		</button>
		<div class="collapse navbar-collapse" id="navbarResponsive">
            <!-- CAMBIO WEB_INSESO: accesos organizados por recorrido. -->
            <ul class="navbar-nav">
              <li class="nav-item"><a class="nav-link" href={getLocalizedPath('/',lang)}>{t('nav.home')}</a></li>
              <li class="nav-item"><a class="nav-link" href={getLocalizedPath('/noticias',lang)}>{t('nav.news')}</a></li>
              {menus.map((menu,i)=><Fragment>{i===3 && <li class="nav-item"><a class="nav-link" href={getLocalizedPath('/formularios-web',lang)}>{labels.forms}</a></li>}<li class="nav-item dropdown"><a class="nav-link" href="#" id={`nav-new-${i}`} data-nav-dropdown aria-haspopup="true" aria-expanded="false">{menu.label} <i class="fas fa-sort-down"></i></a><div class="dropdown-menu" aria-labelledby={`nav-new-${i}`}>{menu.links.map(([path,label])=><a class="dropdown-item" href={getLocalizedPath(path,lang)}>{label}</a>)}</div></li></Fragment>)}
            </ul>
		</div>
    <div class="lang-switcher-universal"><LanguageSwitcher currentLang={lang} currentPath={currentPath}/></div>
	</div>
</nav>


<style is:global>
/* CAMBIO DEFINITIVO: emblemas a la izquierda, menú central e idioma a la derecha; misma paleta. */
.top-nav{text-transform:uppercase}.navbar.top-nav>.container{width:100%;max-width:1680px;padding:0 24px;display:grid;grid-template-columns:160px minmax(0,1fr) auto;align-items:center;gap:20px}.top-nav .navbar-brand{margin:0;justify-self:start}.top-nav .navbar-brand img{display:block;width:160px;max-width:100%;height:92px;object-fit:contain}.top-nav .navbar-collapse{min-width:0;justify-content:center}.top-nav .navbar-nav{justify-content:center;align-items:center;flex-wrap:nowrap;gap:2px}.top-nav .navbar-nav .nav-link{padding:.7rem .55rem;font-size:.85rem;white-space:nowrap;text-transform:uppercase}.top-nav .dropdown-item,.top-nav .language-switcher{text-transform:uppercase}.lang-switcher-universal{position:static;justify-self:end}.navbar.top-nav .navbar-nav .dropdown-menu:not(.show){display:none!important}.navbar.top-nav .navbar-nav .dropdown-menu.show{display:block!important;background:#225924!important;left:0!important;right:auto!important;transform:none!important}.top-nav [data-nav-dropdown]:focus-visible,.top-nav [data-nav-toggle]:focus-visible{outline:3px solid #367a40;outline-offset:3px}
@media(max-width:1199px){.navbar.top-nav>.container{grid-template-columns:140px minmax(0,1fr) auto;gap:12px;padding:0 16px}.top-nav .navbar-brand img{width:140px;height:84px}.top-nav .navbar-nav .nav-link{font-size:.77rem;padding:.6rem .35rem}}
@media(max-width:991px){.navbar.top-nav>.container{grid-template-columns:minmax(0,1fr) auto 38px;gap:10px;padding:0 12px}.top-nav .navbar-brand{grid-column:1;grid-row:1}.top-nav .navbar-brand img{width:130px;height:74px}.top-nav .lang-switcher-universal{grid-column:2;grid-row:1}.top-nav .navbar-toggler{grid-column:3;grid-row:1;margin:0;padding:.35rem}.top-nav .navbar-collapse{grid-column:1/-1;grid-row:2;width:100%}.top-nav .navbar-nav{align-items:stretch;flex-wrap:nowrap}.top-nav .dropdown-menu{position:static;float:none}.top-nav .navbar-nav .nav-link{font-size:.9rem;min-height:44px;white-space:normal}}
/* CAMBIO 28/10: una sola fila en escritorio; prevalece sobre las hojas heredadas. */
@media(min-width:992px){.navbar.navbar-expand-lg.top-nav .navbar-nav{display:flex;flex-direction:row;flex-wrap:nowrap;gap:clamp(.3rem,.7vw,.9rem)}.navbar.navbar-expand-lg.top-nav .navbar-nav>.nav-item{flex:0 0 auto}.navbar.navbar-expand-lg.top-nav .navbar-nav>.nav-item>.nav-link{font-size:clamp(.7rem,.9vw,.85rem);padding:.7rem clamp(.2rem,.4vw,.6rem);white-space:nowrap}.navbar.navbar-expand-lg.top-nav .dropdown-menu{min-width:245px}.navbar.navbar-expand-lg.top-nav .dropdown-menu .dropdown-item{white-space:normal;line-height:1.5}}
</style>
