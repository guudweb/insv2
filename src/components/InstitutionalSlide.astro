---
// CAMBIO WEB_INSESO: avance automático cada cuatro segundos, sin controles superpuestos.
import {getLangFromUrl} from '../i18n/utils';
import {createLocalizer} from '../i18n/release.mjs';
const l=createLocalizer(getLangFromUrl(Astro.url));
interface Props {frame?:number;alt:string;}
const {frame=0,alt}=Astro.props;
const order=[frame%3,(frame+1)%3,(frame+2)%3];
const captions=['Proteger hoy, asegurar mañana','Seguridad social para todos, hoy y mañana','Su bienestar, nuestro compromiso'];
---
<section class="institutional-slide" data-institutional-carousel data-interval="4000" role="region" aria-roledescription={l("carrusel")} aria-label={l(alt)}>
 <div class="slide-track">{order.map((index,i)=><img class:list={{'is-active':i===0}} data-institutional-frame src={`/images/adaptadas/presentation-${index}.png`} alt={l(captions[index])} width="1280" height="427" aria-hidden={i!==0} loading={i===0?'eager':'lazy'} />)}</div>

</section>
<script>
function bindInstitutionalSlides(){document.querySelectorAll<HTMLElement>('[data-institutional-carousel]').forEach(root=>{if(root.dataset.bound)return;root.dataset.bound='true';const frames=[...root.querySelectorAll<HTMLImageElement>('[data-institutional-frame]')],motion=window.matchMedia('(prefers-reduced-motion: reduce)');let index=0,paused=motion.matches,hover=false,focused=false,timer:ReturnType<typeof setInterval>|undefined;
const show=(next:number)=>{index=(next+frames.length)%frames.length;frames.forEach((frame,i)=>{frame.classList.toggle('is-active',i===index);frame.setAttribute('aria-hidden',String(i!==index));});};
const sync=()=>{if(timer)clearInterval(timer);timer=undefined;if(!paused&&!hover&&!focused)timer=setInterval(()=>{if(!root.isConnected){if(timer)clearInterval(timer);return;}show(index+1);},Number(root.dataset.interval)||4000);};
root.addEventListener('mouseenter',()=>{hover=true;sync();});root.addEventListener('mouseleave',()=>{hover=false;sync();});root.addEventListener('focusin',()=>{focused=true;sync();});root.addEventListener('focusout',e=>{if(!root.contains((e as FocusEvent).relatedTarget as Node)){focused=false;sync();}});motion.addEventListener('change',()=>{paused=motion.matches;sync();});sync();});}
bindInstitutionalSlides();document.addEventListener('astro:page-load',bindInstitutionalSlides);
</script>
<style>.institutional-slide{position:relative;background:#17522a;width:100%;overflow:hidden}.slide-track{position:relative;width:100%;max-width:1500px;aspect-ratio:3/1;margin:auto}.slide-track img{position:absolute;inset:0;display:block;width:100%;height:100%;object-fit:contain;filter:brightness(1.16) contrast(1.04);opacity:0;transition:opacity .45s ease;pointer-events:none}.slide-track img.is-active{opacity:1}@media(prefers-reduced-motion:reduce){.slide-track img{transition:none}}</style>
