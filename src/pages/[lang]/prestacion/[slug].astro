---
// CAMBIO INSESO 2026-10-13 R2: rutas limitadas al catálogo autorizado de ocho prestaciones.
import PrestacionLayout from '../../../layouts/PrestacionLayout.astro';
import {benefitCatalog,canonicalBenefit} from '../../../data/benefit-catalog';
export const prerender=false;
const slug=canonicalBenefit(Astro.params.slug||'');
if(!benefitCatalog.some(b=>b.slug===slug))return new Response('Prestación no incluida en el catálogo',{status:404});
---
<PrestacionLayout slug={slug}/>
