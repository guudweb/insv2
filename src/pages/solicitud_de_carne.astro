---
import { createLocalizer } from '../i18n/release.mjs';
// CAMBIO INSESO 2026-10-13: identidad verde y correcciones previas; detalles en docs/CAMBIOS_REVISION_2.md.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PartnersCarousel from '../components/PartnersCarousel.astro';
import { getSocios } from '../lib/strapi';
import { useTranslations } from '../i18n/utils';

export const prerender = false;

const t = useTranslations('es');
const socios = await getSocios();
const l = createLocalizer('es');
---

<BaseLayout title={t('cardRequest.pageTitle')} currentPath="/solicitud_de_carne">
  <PageHeader
    imageSrc="/images/adaptadas/companies-header.png"
    imageAlt={t('cardRequest.headerAlt')}
  />

  <div class="container">
    <div class="about-main">
      <div class="row">
        <div class="col-lg-6">
          <h2>{t('cardRequest.title')}</h2>
          <p>{t('cardRequest.description')}</p>

          <div class="card my-4">
            <h4 class="card-header">Primera solicitud · {t('cardRequest.requirementsTitle')}</h4>
            <div class="card-body">
              <ul>
                <li><h6>{t('cardRequest.req1')}</h6></li>
                <li><h6>{t('cardRequest.req2')}</h6></li>
                <li><h6>{t('cardRequest.req3')}</h6></li>
                <li><h6>{t('cardRequest.req4')}</h6></li>
                <li><h6>{t('cardRequest.req5')}</h6></li>
              </ul>
            </div>
          </div>

          <!--
          <div class="card my-4">
            <h4 class="card-header">{l("Renovación del carné")}</h4>
            <div class="card-body">
              <p>{l("Consulte con INSESO los requisitos vigentes para la renovación de su carné.")}</p>
            </div>
          </div>

          <div class="card my-4">
            <h4 class="card-header">{t('cardRequest.duplicateTitle')}</h4>
            <div class="card-body">
              <ul>
                <li><h6>{t('cardRequest.dupReq1')}</h6></li>
                <li><h6>{t('cardRequest.dupReq2')}</h6></li>
                <li><h6>{t('cardRequest.dupReq3')}</h6></li>
                <li><h6>{t('cardRequest.dupReq4')}</h6></li>
              </ul>
            </div>
          </div>
          -->
        </div>

        <div class="col-lg-6">
          <img
            class="img-fluid w-100 rounded mb-4"
            src="/images/trabajadores/img_trabaja_02.jpg"
            alt={t('cardRequest.imageAlt')}
          />

          <!--
          <h4 class="card-header">{t('cardRequest.deliveryTitle')}</h4>
          <div class="card-body">
            <p>
              <strong>{t('cardRequest.normalTime')}</strong> {t('cardRequest.normalDays')}<br />
              <strong>{t('cardRequest.urgentTime')}</strong> {t('cardRequest.urgentDays')}
            </p>
          </div>
          -->

          <hr />
          <img
            class="img-fluid w-100 rounded mb-4"
            src="/images/adaptadas/presentation-3.webp"
            alt={l('INSESO · Llame al 1066')}
          />
        </div>
      </div>
    </div>
  </div>

  <PartnersCarousel socios={socios} />
</BaseLayout>